TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_TARGET_CHAT_ID=replace_me
TELEGRAM_MESSAGE_THREAD_ID=replace_me

# Gitea API (для напоминаний о непроверенных ревью)
GITEA_URL=https://gitea.example.com
GITEA_TOKEN=replace_me
# Список репозиториев через запятую: owner/repo1,owner/repo2
GITEA_REPOSITORIES=owner/repo1,owner/repo2
# Через сколько часов после запроса ревью присылать напоминание
GITEA_REVIEW_REMINDER_HOURS=24
